# claude
# extended keys (shift+enter etc.) need tmux >= 3.2; guard so old cluster tmux
# doesn't choke on unknown options
if-shell 'tmux -V | grep -qE "tmux (3\.[2-9]|3\.[1-9][0-9]|[4-9]\.)"' \
  'set -s extended-keys on ; set -as terminal-features "xterm*:extkeys"'
# allow-passthrough (notifications/progress) exists only in >= 3.3; the
# behavior was unconditionally on in older tmux, so nothing is lost below 3.3
if-shell 'tmux -V | grep -qE "tmux (3\.[3-9]|3\.[1-9][0-9]|[4-9]\.)"' \
  'set -g allow-passthrough on'
