set -g mouse on
set -g status off
set-option -g default-terminal "screen-256color"
set -s escape-time 0

unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind -n M-Enter split-window -h -c "#{pane_current_path}"
bind -n M-Bspace split-window -v -c "#{pane_current_path}"

bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D

bind -n M-S-Left resize-pane -L
bind -n M-S-Right resize-pane -R
bind -n M-S-Up resize-pane -U
bind -n M-S-Down resize-pane -D

bind -n M-h select-pane -L
bind -n M-l select-pane -R
bind -n M-k select-pane -U
bind -n M-j select-pane -D

bind -n M-S-H resize-pane -L
bind -n M-S-L resize-pane -R
bind -n M-S-K resize-pane -U
bind -n M-S-J resize-pane -D

# clipboard: forward copy-mode copies and app OSC 52 (claude code) out to the
# terminal; the Ms override is needed because xterm-256color terminfo lacks it
set-option -s set-clipboard on
set -as terminal-overrides ',xterm-256color:Ms=\E]52;%p1%s;%p2%s\007'

# vi copy mode: prefix-[ then v to select, y to copy (lands on local clipboard)
setw -g mode-keys vi
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-selection-and-cancel

# mouse drag copy: xclip where it exists (local X11), otherwise swallow the
# pipe; set-clipboard still pushes the copy out via OSC 52 either way
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "command -v xclip >/dev/null && xclip -selection clipboard -i || cat >/dev/null"
bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "command -v xclip >/dev/null && xclip -selection clipboard -i || cat >/dev/null"

